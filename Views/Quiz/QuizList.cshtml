@model DataTable
@using System.Data

<main id="main" class="main">
    <div class="pagetitle">
        <h1>Quiz List</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="DashboardView">Home</a></li>
                <li class="breadcrumb-item">Quiz</li>
                <li class="breadcrumb-item active"><a asp-controller="Quiz" asp-action="QuizList">QuizList</a></li>
            </ol>
        </nav>
    </div><!-- End Page Title -->
    <div class="container">
        <!-- Search Section -->
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Search Quizzes</h5>
                <form class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label for="quizName" class="form-label">Quiz Name</label>
                        <input type="text" class="form-control" id="quizName" placeholder="Enter quiz name">
                    </div>
                    <div class="col-md-3">
                        <label for="quizDate" class="form-label">Quiz Date</label>
                        <input type="date" class="form-control" id="quizDate">
                    </div>
                    <div class="col-md-3">
                        <label for="quizUser" class="form-label">User</label>
                        <select id="quizUser" class="form-select">
                            @foreach (DataRow row in Model.Rows)
                            {
                                <tr>
                                    @* <td>@row["QuizID"]</td> *@
                                    <option>@row["UserName"]</option>
                                    @* <td>@row["QuizName"]</td> *@
                                    @* <td>@row["TotalQuestions"]</td> *@
                                    @* <td>@row["QuizDate"]</td> *@
                                    @* <td>@row["UserName"]</td> *@
                                    @* <td>@row["Created"]</td> *@
                                    @* <td>@row["Modified"]</td> *@
                                    <td>
                                        <a href="#" class="btn btn-primary btn-sm" title="Upload new profile image"><i class="bi bi-pencil"></i></a>
                                        <a href="#" class="btn btn-danger btn-sm" title="Remove my profile image"><i class="bi bi-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        @*     <option selected>Option A</option> *@
                        @*     <option>Option B</option> *@
                        @*     <option>Option C</option> *@
                        @*     <option>Option D</option> *@
                        </select>
                    </div>
                    <div class="col-md-3 d-flex justify-content-start">
                        <button type="button" class="btn btn-primary mx-1">Search</button>
                        <button type="reset" class="btn btn-secondary mx-1">Reset</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Quiz List Section -->
        <div class="card">
            <div class="card-body">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title">Quiz List</h5>
                    <div class="d-flex p-3 justify-content-end">
                        <a class="btn btn-success mx-1" asp-controller="Quiz" asp-action="QuizeAdd"> Add New Quiz</a>
                    </div>
                </div>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            @* <th>#</th> *@
                            <th>Quiz Name</th>
                            <th>Total Questions</th>
                            <th>Quiz Date</th>
                            <th>UserName</th>
                            @* <th>Created</th> *@
                            @* <th>Modified</th> *@
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DataRow row in Model.Rows)
                        {
                            <tr>
                                @* <td>@row["QuizID"]</td> *@
                                <td>@row["QuizName"]</td>
                                <td>@row["TotalQuestions"]</td>
                                <td>@row["QuizDate"]</td>
                                <td>@row["UserName"]</td>
                                @* <td>@row["Created"]</td> *@
                                @* <td>@row["Modified"]</td> *@
                                <td>
                                    <a href="#" class="btn btn-primary btn-sm" title="Upload new profile image"><i class="bi bi-pencil"></i></a>
                                    <a href="#" class="btn btn-danger btn-sm" title="Remove my profile image"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                        <!-- Add more rows as needed -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>