<main id="main" class="main">
    <div class="container">
        <div class="pagetitle">
            <h1>Quiz Add</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="DashboardView">Home</a></li>
                    <li class="breadcrumb-item">Quiz</li>
                    <li class="breadcrumb-item active"><a asp-controller="Quiz" asp-action="QuizAdd">QuizList</a></li>
                </ol>
            </nav>
        </div><!-- End Page Title -->
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Add New Quiz </h5>
                <form class="row g-3">
                    <div class="col-12">
                        <label for="inputName4" class="form-label"><span class="text-danger">*</span>Quiz Name</label>
                        <input type="text" class="form-control" id="inputName4">
                    </div>
                    <div class="col-12">
                        <label for="inputQuestions4" class="form-label"><span class="text-danger">*</span>TotalQuestions</label>
                        <input type="number" class="form-control" id="inputQuestions4">
                    </div>
                    <div class="col-12">

                        <label for="inputdate" class="form-label"><span class="text-danger">*</span>QuizDate</label>
                        <input type="date" class="form-control" id="inputdate">
                    </div>
                    @* <div class="col-12"> *@
                    @*     <label for="quizUser" class="form-label">User</label> *@
                    @*     <select id="quizUser" class="form-select"> *@
                    @*         <option selected>Option A</option> *@
                    @*         <option>Option B</option> *@
                    @*         <option>Option C</option> *@
                    @*         <option>Option D</option> *@
                    @*     </select> *@
                    @* </div> *@
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a class="btn btn-secondary" asp-controller="Quiz" asp-action="QuizList">Cancel</a>
                    </div>
                </form><!-- Vertical Form -->
            </div>
        </div>
    </div>
</main>
