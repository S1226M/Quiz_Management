@model DataTable
@using System.Data

<main id="main" class="main">
    <div class="pagetitle">
        <h1>Question Level List</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="DashboardView">Home</a></li>
                <li class="breadcrumb-item">QuestionLevel</li>
                <li class="breadcrumb-item active"><a asp-controller="QuestionLevel" asp-action="QuestionLevelList">QuestionLevelList</a></li>
            </ol>
        </nav>
    </div><!-- End Page Title -->
    <div class="container mt-5">
        <!-- Search Section -->
        <div class="card mb-4">
            <div class="card-body">
            <h5 class="card-title">Search Questions</h5>
                <form id="searchForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <input type="text" class="form-control" id="searchText" placeholder="Enter question text">
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" id="searchLevel">
                                <option value="">Select Level</option>
                                <option value="1">Easy</option>
                                <option value="2">Medium</option>
                                <option value="3">Hard</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <table>
                                <tr>
                                    <td class="col-3">
                                        <button type="button" class="btn btn-primary w-100" id="searchBtn">Search</button>
                                    </td>
                                    <td class="col-3">
                                        <button type="button" class="btn btn-secondary" id="resetBtn">Reset</button>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Question List Section -->
        <div class="card">
            <div class="card-body">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="card-title">Question Level List</h2>
                    <div class="d-flex p-3 justify-content-end">
                        <a class="btn btn-success" id="addQuestionBtn" asp-controller="QuestionLevel" asp-action="QuestionLevelAdd">Add Question Level</a>
                    </div>
                </div>
                <table class="table table-striped">

                    <thead>
                        <tr>
                            @* <th>QuestionLevelID</th> *@
                            <th>QuestionText</th>
                            <th>QuestionLevel</th>
                            <th>User Name</th>
                            @* <th>Created</th> *@
                            @* <th>Modified</th> *@
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DataRow row in Model.Rows)    
                        {
                            <tr>
                                @* <td>@row["QuestionLevelID"]</td> *@
                                <td>@row["QuestionText"]</td>
                                <td>@row["QuestionLevel"]</td>
                                <td>@row["UserName"]</td>
                                @* <td>@row["Created"]</td> *@
                                @* <td>@row["Modified"]</td> *@
                                <td>
                                    <a href="#" class="btn btn-primary btn-sm" title="Upload new profile image"><i class="bi bi-pencil"></i></a>
                                    <a href="#" class="btn btn-danger btn-sm" title="Remove my profile image"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</main>