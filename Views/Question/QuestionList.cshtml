@model DataTable
@using System.Data

<main id="main" class="main">
    
    <div class="container">
        <div class="pagetitle">
            <h1>Question List</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="DashboardView">Home</a></li>
                    <li class="breadcrumb-item">Question</li>
                    <li class="breadcrumb-item active"><a asp-controller="Question" asp-action="QuestionList">QuestionList</a></li>
                </ol>
            </nav>
        </div><!-- End Page Title -->
        <!-- Search Section -->
        <div class="card mb-4">
            <div class="card-body">
        <h5 class="card-title">Search Question</h5>
                <form id="searchForm">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="questionLevel" class="form-label">Select Question Level</label>
                            <input type="text" class="form-control" id="searchText" placeholder="Question Level">
                        </div>
                        <div class="col-md-4">
                            <label for="questionLevel" class="form-label">Question</label>
                            <input type="text" class="form-control" id="searchText" placeholder="Enter Question">
                        </div>
                        <div class="col-md-4">
                            <label for="questionLevel" class="form-label">Min Mark</label>
                            <input type="text" class="form-control" id="searchText" placeholder="Enter Min Marks">
                        </div>
                        <div class="col-md-4">
                            <label for="questionLevel" class="form-label">Max Mark</label>
                            <input type="text" class="form-control" id="searchText" placeholder="Enter Max Marks">
                        </div>
                        @* <div class="col-md-3"> *@
                        @*     <select class="form-select" id="searchLevel"> *@
                        @*         <option value="">Select Level</option> *@
                        @*         <option value="1">Easy</option> *@
                        @*         <option value="2">Medium</option> *@
                        @*         <option value="3">Hard</option> *@
                        @*     </select> *@
                        @* </div> *@
                        <div class="col-md-10">
                            <button type="button" class="btn btn-primary" id="searchBtn">Search</button>
                            <button type="button" class="btn btn-secondary" id="resetBtn">Reset</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Question List Section -->
        <div class="card">
            <div class="card-body">
                <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title">Question List</h5>
                    <div class="d-flex p-3 justify-content-end">
                        <a class="btn btn-success" id="addQuestionBtn" asp-controller="Question" asp-action="QuestionAdd">Add New Question</a>
                    </div>
                </div>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            @* <th>#</th> *@
                            <th>Question Text</th>
                            <th>Level</th>
                            <th>Marks</th>
                            <th>UserName</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="questionTable">
                        <!-- Dynamic rows will be added here -->
                        @foreach (DataRow row in Model.Rows)
                        {
                            <tr>
                                @* <td>@row["QuestionID"]</td> *@
                                <td>@row["QuestionText"]</td>
                                <td>@row["QuestionLevel"]</td>
                                <td>@row["QuestionMarks"]</td>
                                <td>@row["UserName"]</td>
                                <td>
                                    <a href="#" class="btn btn-primary btn-sm" title="Upload new profile image"><i class="bi bi-pencil"></i></a>
                                    <a href="#" class="btn btn-danger btn-sm" title="Remove my profile image"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>