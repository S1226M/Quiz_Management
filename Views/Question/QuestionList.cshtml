@model DataTable
@using System.Data

<main id="main" class="main">
    
    <div class="container">
        <div class="pagetitle">
            <h1>Question List</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="DashboardView">Home</a></li>
                    <li class="breadcrumb-item">Question</li>
                    <li class="breadcrumb-item active"><a asp-controller="Question" asp-action="QuestionList">QuestionList</a></li>
                </ol>
            </nav>
        </div><!-- End Page Title -->
        <!-- Search Section -->
        <div class="card mb-4">
            <div class="card-body">
        <h5 class="card-title">Search Question</h5>
                <form id="searchForm" method="POST" asp-controller="Question" asp-action="QuestionFilter" asp-route-filter="true">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="QuestionText" class="form-label">Question</label>
                            <input type="text" class="form-control" id="QuestionText" name="QuestionText" placeholder="Enter Question">
                        </div>
                        <div class="col-md-4">
                            <label for="QuestionLevel" class="form-label">Select Question Level</label>
                            <input type="text" class="form-control" id="QuestionLevel" name="QuestionLevel" placeholder="Enter Question Level">
                        </div>
                        <div class="col-md-4">
                            <label for="QuestionMarks" class="form-label">Question Mark</label>
                            <input type="number" class="form-control" id="QuestionMarks" name="QuestionMarks" placeholder="Enter Marks">
                        </div>
                        <div class="col-md-10">
                            <button type="submit" class="btn btn-primary" id="searchBtn">Search</button>
                            <button type="reset" class="btn btn-secondary" id="resetBtn">Reset</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Question List Section -->
        <div class="card">
            <div class="card-body">
                <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title">Question List</h5>
                    <div class="d-flex p-3 justify-content-end">
                        <a class="btn btn-success" id="addQuestionBtn" asp-controller="Question" asp-action="QuestionAddEdit">Add New Question</a>
                    </div>
                </div>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            @* <th>#</th> *@
                            <th>Question Text</th>
                            <th>Option A</th>
                            <th>Option B</th>
                            <th>Option C</th>
                            <th>Option D</th>
                            <th>Correct Option</th>
                            <th>Level</th>
                            <th>Marks</th>
                            @* <th>UserName</th> *@
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="questionTable">
                        <!-- Dynamic rows will be added here -->
                        @foreach (DataRow row in Model.Rows)
                        {
                            <tr>
                                @* <td>@row["QuestionID"]</td> *@
                                <td>@row["QuestionText"]</td>
                                <td>@row["OptionA"]</td>
                                <td>@row["OptionB"]</td>
                                <td>@row["OptionC"]</td>
                                <td>@row["OptionD"]</td>
                                <td>@row["CorrectOption"]</td>
                                <td style="color: @(row["QuestionLevel"].ToString() == "Hard" ? "red" :
                                                    row["QuestionLevel"].ToString() == "Medium" ? "orange" :
                                                    row["QuestionLevel"].ToString() == "Eassy" ? "green" : "black")">
                                                @row["QuestionLevel"]
                                </td>
                                <td>@row["QuestionMarks"]</td>
                                <td>
                                    <a asp-controller="Question" asp-action="QuestionAddEdit" asp-route-QuestionID="@row["QuestionID"]" class="btn btn-primary btn-sm" title="Upload new profile image"><i class="bi bi-pencil"></i></a>
                                    <a asp-controller="Question" asp-action="QuestionDelete" asp-route-QuestionID="@row["QuestionID"]" onclick="return confirm('Are you sure you want to delete this user?');" class="btn btn-danger btn-sm" title="Remove my profile image"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>