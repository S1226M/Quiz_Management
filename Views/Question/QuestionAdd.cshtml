                    <div class="col-12">
                        <label for="inputOptionB4" class="form-label"><span class="text-danger">*</span>Option B </label>
                        <input type="text" class="form-control" id="inputOptionB4">
                    </div>
                    <div class="col-12">
                        <label for="inputOptionC4" class="form-label"><span class="text-danger">*</span>Option C </label>
                        <input type="text" class="form-control" id="inputOptionC4">
                    </div>
                    <div class="col-12">
                        <label for="inputOptionD4" class="form-label"><span class="text-danger">*</span>Option D </label>
