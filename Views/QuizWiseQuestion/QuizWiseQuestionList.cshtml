@model DataTable
@using System.Data

<main id="main" class="main">
    <div class="container-fluid">
        <!-- Search Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Search</h5>
                        <form>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <input type="text" class="form-control" placeholder="Enter Quiz ID">
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="form-control" placeholder="Enter Question ID">
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-success me-2">Search</button>
                                    <button type="reset" class="btn btn-secondary">Reset</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Section -->
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title">Quiz List</h5>
                    <a class="btn btn-success" id="addQuiz" asp-controller="Quiz" asp-action="QuizAddEdit">Add Quiz</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Quiz ID</th>
                                <th>Quiz Name</th>
                                <th>User Name</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(DataRow row in Model.Rows)
                            {
                                <tr> 
                                    <td>@row["QuizID"]</td>
                                    <td>@row["QuizName"]</td> 
                                    <td>@row["UserName"]</td> 
                                    <td>
                                        <a asp-controller="QuizWiseQuestion_Question" asp-action="QuizWiseQuestionQuestionList" asp-route-QuizID="@row["QuizID"]" class="btn btn-primary btn-sm" title="Upload new profile image">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>
