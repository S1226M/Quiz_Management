@model DataTable
@using System.Data

<main id="main" class="main">
    <div class="container-fluid">
        <!-- Search Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Search</h5>
                        <form asp-action="QuizWiseQuestionQuizFilter" asp-controller="QuizWiseQuestion" method="post" asp-route-filter="true">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label for="QuizName" class="form-label">Quiz Name</label>
                                    <input type="text" class="form-control" id="QuizName" name="QuizName" placeholder="Enter Quiz Name">
                                </div>
                                <div class="col-md-3">
                                    <label for="UserName" class="form-label">User Name</label>
                                    <input type="text" class="form-control" id="UserName" name="UserName" placeholder="Enter User Name">
                                </div>
                                <div class="d-flex justify-content-start">
                                    <button type="submit" class="btn btn-primary mx-1">Search</button>
                                    <button type="reset" class="btn btn-secondary mx-1">Reset</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Section -->
        <div class="card">
            <div class="card-body">
                <div class="pull-right col-md-3 my-2">
                    <div id="sample_1_filter" class="dataTables_filter">
                        <input type="text" class="form-control input-group-sm input-small input-inline" id="sample_1" placeholder="Search" aria-controls="sample_1">
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title">Quiz List</h5>
                    <a class="btn btn-success" id="addQuiz" asp-controller="Quiz" asp-action="QuizAddEdit">Add Quiz</a>
                </div>
                <div class="table-responsive">
                    <table id="sample_1" class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Quiz ID</th>
                                <th>Quiz Name</th>
                                <th>User Name</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="sample_2">
                            @foreach(DataRow row in Model.Rows)
                            {
                                <tr> 
                                    <td>@row["QuizID"]</td>
                                    <td>@row["QuizName"]</td> 
                                    <td>@row["UserName"]</td> 
                                    <td>
                                        <a asp-controller="QuizWiseQuestion_Question" asp-action="QuizWiseQuestionQuestionList" asp-route-QuizID="@row["QuizID"]" class="btn btn-primary btn-sm" title="Upload new profile image">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>
@section Scripts
{
    <script>
        $(document).ready(function () {
            $("#sample_1").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#sample_2 tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}