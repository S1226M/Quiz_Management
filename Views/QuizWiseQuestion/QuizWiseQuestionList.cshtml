<main id="main" class="main">
    <div class="container">
        <div class="pagetitle">
            <h1>Quiz Wise Question</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="DashboardView">Home</a></li>
                    <li class="breadcrumb-item">QuizWiseQuestion</li>
                    <li class="breadcrumb-item active"><a asp-controller="QuizWiseQuestion" asp-action="QuizWiseQuestionList">QuizWiseQuestionList</a></li>
                </ol>
            </nav>
        </div><!-- End Page Title -->

        <!-- Search Section -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title">Search Questions</h5>
            </div>
            <div class="card-body">
                <form class="row g-3">
                    @* <div class="col-md-4"> *@
                    @*     <input type="text" class="form-control" placeholder="Select Quiz"> *@
                    @* </div> *@
                    <label for="quizName" class="form-label">Select Quiz</label>
                    <div class="row">
                        <div class="col-sm-4">
                            <select class="form-select" aria-label="Default select example">
                                <option selected>-- Select Quiz</option>
                                <option>One</option>
                                <option>Two</option>
                                <option>Three</option>
                            </select>
                        </div>
                    </div>
                    <div class="text-start">
                        <button type="submit" class="btn btn-primary">Search</button>
                        <button type="reset" class="btn btn-secondary">Reset</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Question List Section -->
        <div class="card">
            <div class="card-body">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title">Question Level List</h5>
                    <div class="d-flex p-3 justify-content-end">
                        <a class="btn btn-success" id="addQuestionBtn" asp-controller="QuizWiseQuestion" asp-action="QuizWiseQuestionAdd">Add Question Level</a>
                    </div>
                </div>
                <table class="table table-striped">

                    <thead>
                        <tr>
                            @* <th>QuizWiseQuestionsID</th> *@
                            <th>Quiz Name</th>
                            @* <th>Question Text</th> *@
                            <th>User Name</th>
                            <th>Total Question</th>
                            <th>Action</th>
                            @* <th>Created</th> *@
                            @* <th>Action</th> *@
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            @* <td>1</td> *@
                            <td>
                                ASP.NET is a ____.
                            </td>
                            @* <td>You i am</td> *@
                            <td>Karan</td>
                            <td>25</td>
                            @* <td>2023/05/20</td> *@
                            <td>
                                <a href="#" class="btn btn-primary btn-sm" title="Upload new profile image"><i class="bi bi-exclamation-circle"></i></a>
                                <a href="#" class="btn btn-primary btn-sm" title="Upload new profile image"><i class="bi bi-pencil"></i></a>
                                <a href="#" class="btn btn-danger btn-sm" title="Remove my profile image"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                        <tr>
                            @* <td>1</td> *@
                            <td>
                                View is a ____.
                            </td>
                            @* <td>Helo return</td> *@
                            <td>Yash</td>
                            @* <td>2018/02/25</td> *@
                            <td>20</td>
                            <td>
                                <a href="#" class="btn btn-primary btn-sm" title="Upload new profile image"><i class="bi bi-exclamation-circle"></i></a>
                                <a href="#" class="btn btn-primary btn-sm" title="Upload new profile image"><i class="bi bi-pencil"></i></a>
                                <a href="#" class="btn btn-danger btn-sm" title="Remove my profile image"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>