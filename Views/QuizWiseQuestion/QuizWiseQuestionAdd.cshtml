<main id="main" class="main">
    <div class="pagetitle">
        <h1>Quiz Wise Question Add</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="DashboardView">Home</a></li>
                <li class="breadcrumb-item">QuizWiseQuestion</li>
                <li class="breadcrumb-item active"><a asp-controller="QuizWiseQuestion" asp-action="QuizWiseQuestionAdd">QuizWiseQuestionAdd</a></li>
            </ol>
        </nav>
    </div><!-- End Page Title -->
    <div class="container">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Add New Question </h5>
                <form class="row g-3">
                    <div class="col-12">
                        <label for="quizUser" class="form-label">QuizID</label>
                        <select id="quizUser" class="form-select">
                            <option selected>Option A</option>
                            <option>Option B</option>
                            <option>Option C</option>
                            <option>Option D</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label for="quizUser" class="form-label">QuestionID</label>
                        <select id="quizUser" class="form-select">
                            <option selected>Option A</option>
                            <option>Option B</option>
                            <option>Option C</option>
                            <option>Option D</option>
                        </select>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a class="btn btn-secondary" asp-controller="QuestionLevel" asp-action="List">Cancel</a>
                    </div>
                </form><!-- Vertical Form -->
            </div>
        </div>
    </div>
</main>