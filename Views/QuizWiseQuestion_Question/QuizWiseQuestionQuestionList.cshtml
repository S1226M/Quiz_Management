@model DataTable
@using System.Data

<main id="main" class="main">
    <div class="container-fluid">
        <!-- Table Section -->
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-end align-items-center my-3">
                    <a asp-controller="QuizWiseQuestion_Question" asp-action="QuestionAddInQuiz" asp-route-QuizID="@Model.Rows[0]["QuizID"]" class="btn btn-primary btn-sm px-4 py-2 mx-3">+ Add AddQuizWiseQuestion</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>QuestionText</th>
                                <th>OptionA</th>
                                <th>OptionB</th>
                                <th>OptionC</th>
                                <th>OptionD</th>
								<th>CorrectOption</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DataRow row in Model.Rows)
                            {
                                <tr>
                                    <td>@row["QuizID"]</td>
                                    <td>@row["QuestionText"]</td>
                                    <td>@row["OptionA"]</td>
									<td>@row["OptionB"]</td>
									<td>@row["OptionC"]</td>
									<td>@row["OptionD"]</td>
									<td>@row["CorrectOption"]</td>
                                    <td>
                                        <a asp-controller="QuizWiseQuestion_Question" asp-action="QuestionAddInQuiz" asp-route-QuizID="@row["QuizID"]" class="btn btn-primary btn-sm" title="Upload new profile image">
                                            <i  class="bi bi-pencil"></i>
                                        </a>
                                        <form onsubmit="return confirmDelete()" style="display:inline;">
                                            @* <input type="hidden" name="QuizWiseQuestionsID" value="@row["QuizWiseQuestionsID"]" /> *@
                                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>
